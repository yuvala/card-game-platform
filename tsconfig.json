{
  "compilerOptions": {
    "target": "ES2020",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@engine": ["packages/engine/src/index.ts"],
      "@engine/*": ["packages/engine/src/*"]
    }
  },
  "include": ["apps/client/src/**/*.ts", "apps/client/src/**/*.tsx", "packages/**/*.ts"]
}
