{
  "compilerOptions": {
    "target": "ES2020",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@rewrite-core": ["packages/rewrite-core/src/index.ts"],
      "@rewrite-core/*": ["packages/rewrite-core/src/*"]
    }
  },
  "include": ["html/src/**/*.ts", "packages/**/*.ts"]
}
