{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": ".tmp-simulate",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@engine": ["packages/engine/src/index.ts"],
      "@engine/*": ["packages/engine/src/*"]
    }
  },
  "files": [
    "scripts/simulate.ts"
  ]
}
