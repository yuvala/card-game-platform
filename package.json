{
  "name": "card-game",
  "version": "1.0.0",
  "private": true,
  "description": "Legacy browser card game migrated to Vite and TypeScript.",
  "scripts": {
    "start": "vite --config vite.config.js",
    "dev": "vite --config vite.config.js",
    "build": "tsc --noEmit && vite build --config vite.config.js",
    "test": "\"%npm_node_execpath%\" .\\scripts\\run-tests.cjs",
    "test:e2e": "playwright test",
    "test-rewrite": "\"%npm_node_execpath%\" .\\scripts\\run-tests.cjs",
    "smoke": "node .\\scripts\\smoke.cjs",
    "smoke:rewrite": "node .\\scripts\\smoke.cjs",
    "build:server": "tsc -p tsconfig.server.json --noEmit",
    "simulate": "\"%npm_node_execpath%\" .\\scripts\\simulate.cjs",
    "serve:ws": "tsc -p tsconfig.server.json && node .\\scripts\\resolve-engine-aliases.cjs .tmp-server && node .tmp-server/apps/server/src/gameServer.js",
    "preview": "vite preview --config vite.config.js",
    "serve:legacy": "node node.js/server.js",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\""
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/pino": "^7.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@types/howler": "^2.2.13",
    "howler": "^2.2.4",
    "phaser": "^4.0.0",
    "pino": "^10.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "ws": "^8.20.0",
    "xstate": "^5.30.0",
    "zod": "^4.4.3"
  }
}
