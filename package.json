{
  "name": "card-game",
  "version": "1.0.0",
  "private": true,
  "description": "Legacy browser card game migrated to Vite and TypeScript.",
  "scripts": {
    "start": "vite --config vite.config.js",
    "dev": "vite --config vite.config.js",
    "build": "tsc --noEmit && vite build --config vite.config.js",
    "test:rewrite": "\"%npm_node_execpath%\" .\\scripts\\run-rewrite-tests.cjs",
    "test-rewrite": "\"%npm_node_execpath%\" .\\scripts\\run-rewrite-tests.cjs",
    "smoke:rewrite": "node .\\scripts\\smoke-rewrite.cjs",
    "preview": "vite preview --config vite.config.js",
    "serve:legacy": "node node.js/server.js"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "phaser": "^4.0.0",
    "xstate": "^5.30.0"
  }
}
