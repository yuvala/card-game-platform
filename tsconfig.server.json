{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": ".tmp-rewrite-server",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@rewrite-core": ["packages/rewrite-core/src/index.ts"],
      "@rewrite-core/*": ["packages/rewrite-core/src/*"]
    }
  },
  "include": [
    "apps/server/**/*.ts",
    "packages/**/*.ts",
    "html/data/**/*.json"
  ]
}
